# ============================================================================
# Secrets — never commit
# ============================================================================
.env
.env.*
!.env.example

# ============================================================================
# IDEs and editors
# ============================================================================
.idea/
.vscode/
.project
.buildpath
.classpath
.settings/
*.iml
*.launch

# ============================================================================
# OS junk
# ============================================================================
.DS_Store
Thumbs.db

# ============================================================================
# Source / build output
# ============================================================================
nibl.co.uk/node_modules/
nibl.co.uk/vendor/
nibl.co.uk/.phpunit.result.cache
nibl.co.uk/public/build/
nibl.co.uk/public/hot/
nibl.co.uk/public/storage
niblirc/target/

# ============================================================================
# Runtime logs (application log files, one subdir per project)
# ============================================================================
logs/

# ============================================================================
# Runtime data (one subdir per project, relative to the repo root)
# ============================================================================
data/niblmysql/
data/nibl.co.uk/
data/niblirc/

# swag's /config lives under data/swag/; its committed nginx/php proxy config is
# tracked, but its live state (certs, Let's Encrypt accounts, geoip DB, fail2ban
# DB) is ignored.
data/swag/.donoteditthisfile.conf
data/swag/keys/
data/swag/etc/letsencrypt/
data/swag/geoip2db/
data/swag/fail2ban/*.sqlite3*

# ============================================================================
# Legacy runtime dirs from the pre-monorepo layout (kept until migrated/removed)
# ============================================================================
nibl.co.uk/var/
niblmysql/data/
niblmysql/data.bak/
niblmysql/host/
niblmysql/backup/