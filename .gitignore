# ============================================================================
# Secrets — never commit
# ============================================================================
.env
.env.*
!.env.example
niblirc/config/config.txt

# ============================================================================
# IDEs and editors
# ============================================================================
.idea/
.vscode/
.project
.buildpath
.classpath
.settings/
*.iml
*.launch

# ============================================================================
# OS junk
# ============================================================================
.DS_Store
Thumbs.db

# ============================================================================
# Source / build output
# ============================================================================
nibl.co.uk/node_modules/
nibl.co.uk/vendor/
nibl.co.uk/.phpunit.result.cache
nibl.co.uk/public/build/
nibl.co.uk/public/hot/
nibl.co.uk/public/storage
niblirc/target/

# ============================================================================
# Runtime logs (application log files, one subdir per project)
# ============================================================================
logs/

# ============================================================================
# Runtime data (one subdir per project, relative to the repo root)
# ============================================================================
data/niblmysql/
data/nibl.co.uk/
data/niblirc/

# swag's /config lives under data/swag/ and is regenerated on container init;
# only the two custom reverse-proxy confs below are versioned. Ignore everything
# else it creates (nginx/php/www base config, samples, certs, Let's Encrypt
# accounts, geoip DB, fail2ban DB).
data/swag/*
!data/swag/nginx/
data/swag/nginx/*
!data/swag/nginx/proxy-confs/
data/swag/nginx/proxy-confs/*
!data/swag/nginx/proxy-confs/nibl.co.uk.subdomain.conf
!data/swag/nginx/proxy-confs/www.nibl.co.uk.subdomain.conf

# ============================================================================
# Legacy runtime dirs from the pre-monorepo layout (kept until migrated/removed)
# ============================================================================
nibl.co.uk/var/
niblmysql/data/
niblmysql/data.bak/
niblmysql/host/
niblmysql/backup/
