# Combined NIBL environment template.
#
# Copy to .env (chmod 600) and set real values. Never commit .env.
# This single file is the source of truth for every service in the
# docker-compose.yml at the repo root; per-project .env files are gone.
#
# Keep passwords free of single quotes: the niblmysql mysql-init sidecar embeds
# them in SQL strings on every start.

# ============================================================================
# Shared (cross-project) — the SQL database connection
# ============================================================================

# Application DB user/password shared across niblirc, nibl.co.uk and niblmysql.
# Provisioned idempotently (CREATE USER IF NOT EXISTS) by the mysql-init
# sidecar on every start.
SQL_USER=ooinuza
SQL_PASSWORD=change-me

# Shared MySQL connection coordinates (host, port, database name).
SQL_HOST=niblmysql
SQL_PORT=3306
SQL_DATABASE=ooinuza

# ============================================================================
# niblmysql
# ============================================================================

# Root password for the MySQL container and the mysql-init sidecar.
MYSQL_ROOT_PASSWORD=change-me

# Optional (defaults shown)
NIBLMYSQL_BIND=127.0.0.1
NIBLMYSQL_HOST_PORT=3306
# MySQL data + host mounts live inside the repo checkout, relative to
# docker-compose.yml: ./niblmysql/data and ./niblmysql/host (both gitignored).

# ============================================================================
# niblirc
# ============================================================================

# IRC bot identity and connection.
IRC_BOT_NAME=dockerizedBot
IRC_SERVER=irc.rizon.net
IRC_PORT=9999

# DCC port range (must match the ports published in docker-compose.yml).
IRC_DCC_PORTS=46571,46572,46573

# Optional (defaults shown)
# Nickserv password. Leave empty if the bot does not register with NickServ.
IRC_BOT_PASS=
# DCC public address. When blank (the default), resolved from ifconfig.me at
# startup — usually what you want.
#IRC_PUBLIC_IP=
# Database backend selector (mysql).
IRC_DB=mysql

# ============================================================================
# nibl.co.uk
# ============================================================================

# Laravel application key. Generate with:
#   openssl rand -base64 32
# then prefix the output with "base64:".
WEB_APP_KEY=

# Optional (defaults shown)
WEB_APP_URL=https://www.nibl.co.uk
WEB_LOG_LEVEL=info
# Daily log retention in days (Laravel daily channel).
WEB_LOG_DAILY_DAYS=14
WEB_DATA_CACHE=apcu
WEB_HTTP_PORT=8080

# ============================================================================
# swag (linuxserver/swag — Let's Encrypt TLS gateway)
# ============================================================================

# Let's Encrypt account email — required to obtain a certificate.
SWAG_EMAIL=

# Optional (defaults shown)
SWAG_URL=nibl.co.uk
SWAG_SUBDOMAINS=www
SWAG_VALIDATION=http
SWAG_STAGING=false
SWAG_PUID=1000
SWAG_PGID=1000
SWAG_TZ=America/New_York